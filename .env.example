# Banco de dados PostgreSQL
# Local: suba com `docker compose up -d` e use os valores abaixo.
# Produção (Neon/Supabase): DATABASE_URL = conexão com pool (pooled); DIRECT_URL = conexão direta.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/horus"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/horus"

# Segredo para assinar as sessões (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

# Código exigido na tela /setup (criação do primeiro administrador). Obrigatório em produção.
SETUP_TOKEN=""

# URL pública do sistema (usada em links enviados por WhatsApp)
APP_URL="http://localhost:3000"

# IA (Claude / Anthropic). Sem chave, o bot usa regras simples de palavras‑chave.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# WhatsApp Cloud API (Meta). Sem token, as mensagens de saída são apenas registradas no log/banco.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="horus-verify-token"
WHATSAPP_APP_SECRET=""

# Token para o endpoint /api/cameras/status (monitoramento automático das câmeras)
CAMERA_WEBHOOK_TOKEN=""

# Número de WhatsApp exibido no botão flutuante do site (somente dígitos, ex: 5511999998888)
NEXT_PUBLIC_WHATSAPP_NUMBER=""
