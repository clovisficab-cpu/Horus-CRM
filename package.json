{
  "name": "horus-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Horus Videomonitoramento — CRM, central de chamados (IA + WhatsApp), portal do cliente e site institucional",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.3",
    "jose": "^6.2.12",
    "next": "~15.5.27",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "prisma": "~6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
